# Copia este archivo como .env y escribe tus propios valores. .env no se sube al repositorio.
EGRESOS_DB=egresos
EGRESOS_DB_PUERTO=5544
EGRESOS_OWNER_CLAVE=
EGRESOS_APP_CLAVE=
EGRESOS_LECTURA_CLAVE=
EGRESOS_RESPALDO_CLAVE=
# Firma de las sesiones (JWT), como en Estadística: al menos 32 caracteres, aleatorio
# y distinto en cada ambiente. La API no arranca con uno más corto.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# Horas que dura una sesión. 12 por omisión: la guardia de enfermería.
# JWT_HORAS=12
# Clave inicial de las cuentas por área. Con APP_ENV=produccion es provisional: cada
# cuenta la cambia al entrar. Para fijar una clave: python -m semillas.asignar_clave <usuario>
CLAVE_INICIAL_CUENTAS=
# desarrollo habilita el reloj y el reinicio de la demostración. En produccion quedan apagados.
APP_ENV=desarrollo
